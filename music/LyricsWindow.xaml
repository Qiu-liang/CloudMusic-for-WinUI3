<Window
    x:Class="music.LyricsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="歌词">

    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Background>
            <AcrylicBrush x:Name="DynamicBg"
                          TintColor="#1A1A2E"
                          TintOpacity="0.85"
                          FallbackColor="#1A1A2E"
                          AlwaysUseFallback="True"/>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="60*"/>
        </Grid.ColumnDefinitions>

        <!-- 关闭按钮 -->
        <Button x:Name="CloseButton"
                Click="CloseButton_Click"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="16,12,0,0"
                Padding="8"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="20"
                Width="36" Height="36">
            <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="#CCFFFFFF"/>
        </Button>

        <!-- 左侧区域 -->
        <Grid Grid.Column="0" Margin="60,60,30,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 专辑封面 500x500 -->
            <Border x:Name="AlbumCoverBorder"
                    Grid.Row="0"
                    CornerRadius="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="500" Height="500"
                    Background="#22FFFFFF">
                <Image x:Name="AlbumCoverImage"
                       Stretch="UniformToFill"
                       Width="500" Height="500"/>
            </Border>

            <!-- 歌曲信息 -->
            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Spacing="6"
                        Margin="0,30,0,0"
                        MaxWidth="500">
                <TextBlock x:Name="SongTitleText"
                           Text=""
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ArtistText"
                           Text=""
                           FontSize="14"
                           Foreground="#99FFFFFF"
                           HorizontalAlignment="Center"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="AlbumText"
                           Text=""
                           FontSize="12"
                           Foreground="#66FFFFFF"
                           HorizontalAlignment="Center"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- 播放控制 -->
            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Center"
                        Spacing="16"
                        Margin="0,24,0,0">
                <!-- 进度条 -->
                <Grid Width="500">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentTimeText" Grid.Column="0"
                               Text="00:00" FontSize="11" Foreground="#99FFFFFF"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="ProgressSlider" Grid.Column="1"
                            Minimum="0" Maximum="100"
                            VerticalAlignment="Center"
                            ValueChanged="ProgressSlider_ValueChanged"
                            PointerPressed="ProgressSlider_PointerPressed"
                            PointerReleased="ProgressSlider_PointerReleased"
                            IsThumbToolTipEnabled="False"/>
                    <TextBlock x:Name="TotalTimeText" Grid.Column="2"
                               Text="00:00" FontSize="11" Foreground="#99FFFFFF"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <!-- 控制按钮 -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="24">
                    <Button x:Name="ShuffleButton"
                            Click="ShuffleButton_Click"
                            Background="Transparent" BorderThickness="0"
                            Padding="8" Width="40" Height="40">
                        <FontIcon x:Name="ShuffleIcon" Glyph="&#xE8B1;" FontSize="18" Foreground="#CCFFFFFF"/>
                    </Button>
                    <Button x:Name="PrevButton"
                            Click="PrevButton_Click"
                            Background="Transparent" BorderThickness="0"
                            Padding="8" Width="44" Height="44">
                        <FontIcon Glyph="&#xE892;" FontSize="24" Foreground="#CCFFFFFF"/>
                    </Button>
                    <Button x:Name="PlayPauseButton"
                            Click="PlayPauseButton_Click"
                            Background="#33FFFFFF" BorderThickness="0"
                            Padding="0" Width="56" Height="56"
                            CornerRadius="28">
                        <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="28" Foreground="White"/>
                    </Button>
                    <Button x:Name="NextButton"
                            Click="NextButton_Click"
                            Background="Transparent" BorderThickness="0"
                            Padding="8" Width="44" Height="44">
                        <FontIcon Glyph="&#xE893;" FontSize="24" Foreground="#CCFFFFFF"/>
                    </Button>
                    <Button x:Name="RepeatButton"
                            Click="RepeatButton_Click"
                            Background="Transparent" BorderThickness="0"
                            Padding="8" Width="40" Height="40">
                        <FontIcon x:Name="RepeatIcon" Glyph="&#xE8EE;" FontSize="18" Foreground="#CCFFFFFF"/>
                    </Button>
                </StackPanel>

                <!-- 音量控制 -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8">
                    <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="14" Foreground="#99FFFFFF"/>
                    <Slider x:Name="VolumeSlider"
                            Width="120" Minimum="0" Maximum="100" Value="100"
                            ValueChanged="VolumeSlider_ValueChanged"
                            IsThumbToolTipEnabled="False"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 右侧歌词区域 -->
        <Grid Grid.Column="1" Margin="40,0,80,0">
            <ScrollViewer x:Name="LyricsScroller"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="LyricsPanel"
                            Spacing="28"
                            Margin="0,350,0,350"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
