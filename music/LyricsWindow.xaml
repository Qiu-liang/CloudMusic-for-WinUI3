<Window
    x:Class="music.LyricsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Title="歌词">

    <Grid x:Name="RootGrid" Background="#0C0C0E"
          PointerPressed="RootGrid_PointerPressed">

        <!-- 模糊专辑封面背景 -->
        <win2d:CanvasControl x:Name="BackgroundCanvas"
                              Draw="BackgroundCanvas_Draw"
                              IsHitTestVisible="False"
                              Opacity="0.85"/>

        <!-- 轻量暗色渐变叠加：顶部几乎透明、底部加深，保留背景的鲜艳色彩 -->
        <Grid IsHitTestVisible="False">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#08000000" Offset="0"/>
                    <GradientStop Color="#1A000000" Offset="0.55"/>
                    <GradientStop Color="#47000000" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="40*"/>
                <ColumnDefinition x:Name="RightColumn" Width="60*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：封面 + 歌曲信息 + 播放控制（整体垂直居中，控件紧贴封面） -->
            <Grid Grid.Column="0" x:Name="LeftPanel" Margin="48,56,24,40">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">

                    <!-- 专辑封面 -->
                    <Border x:Name="CoverBorder"
                            CornerRadius="12"
                            HorizontalAlignment="Center"
                            MaxWidth="380" MaxHeight="380"
                            Background="#10FFFFFF">
                        <Image x:Name="AlbumCoverImage" Stretch="UniformToFill"/>
                    </Border>

                    <!-- 歌曲信息 -->
                    <StackPanel HorizontalAlignment="Center" Spacing="6" MaxWidth="380">
                        <TextBlock x:Name="SongTitleText" Text=""
                                   FontSize="20" FontWeight="SemiBold"
                                   Foreground="White" HorizontalAlignment="Center"
                                   MaxLines="1" TextTrimming="CharacterEllipsis"
                                   CharacterSpacing="10"/>
                        <TextBlock x:Name="ArtistText" Text=""
                                   FontSize="13" Foreground="#88FFFFFF"
                                   HorizontalAlignment="Center" FontWeight="Normal"
                                   MaxLines="1" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="AlbumText" Text=""
                                   FontSize="12" Foreground="#44FFFFFF"
                                   HorizontalAlignment="Center" FontWeight="Light"
                                   MaxLines="1" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- 播放控制 -->
                    <StackPanel x:Name="ControlsPanel" HorizontalAlignment="Center"
                                Spacing="14" Width="380" Margin="0,8,0,0">

                        <!-- 进度条 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CurrentTimeText" Grid.Column="0"
                                       Text="00:00" FontSize="10" Foreground="#55FFFFFF"
                                       FontFamily="Consolas"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Slider x:Name="ProgressSlider" Grid.Column="1"
                                    Minimum="0" Maximum="100"
                                    VerticalAlignment="Center"
                                    ValueChanged="ProgressSlider_ValueChanged"
                                    IsThumbToolTipEnabled="False"/>
                            <TextBlock x:Name="TotalTimeText" Grid.Column="2"
                                       Text="00:00" FontSize="10" Foreground="#55FFFFFF"
                                       FontFamily="Consolas"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <!-- 播放按钮组 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                            <Button x:Name="ShuffleButton" Click="ShuffleButton_Click"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="8" Width="36" Height="36">
                                <FontIcon x:Name="ShuffleIcon" Glyph="&#xE8B1;" FontSize="14" Foreground="#88FFFFFF"/>
                            </Button>
                            <Button x:Name="PrevButton" Click="PrevButton_Click"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="6" Width="40" Height="40">
                                <FontIcon Glyph="&#xE892;" FontSize="20" Foreground="#CCFFFFFF"/>
                            </Button>
                            <Button x:Name="PlayPauseButton" Click="PlayPauseButton_Click"
                                    Background="#22FFFFFF" BorderThickness="0"
                                    Padding="0" Width="52" Height="52" CornerRadius="26">
                                <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="22" Foreground="White"/>
                            </Button>
                            <Button x:Name="NextButton" Click="NextButton_Click"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="6" Width="40" Height="40">
                                <FontIcon Glyph="&#xE893;" FontSize="20" Foreground="#CCFFFFFF"/>
                            </Button>
                            <Button x:Name="RepeatButton" Click="RepeatButton_Click"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="8" Width="36" Height="36">
                                <FontIcon x:Name="RepeatIcon" Glyph="&#xE8EE;" FontSize="14" Foreground="#88FFFFFF"/>
                            </Button>
                        </StackPanel>

                        <!-- 音量 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="12" Foreground="#55FFFFFF"/>
                            <Slider x:Name="VolumeSlider"
                                    Width="100" Minimum="0" Maximum="100" Value="100"
                                    ValueChanged="VolumeSlider_ValueChanged"
                                    IsThumbToolTipEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 右侧：歌词滚动区域 -->
            <Grid Grid.Column="1" Margin="8,0,56,0">
                <win2d:CanvasControl x:Name="LyricsCanvas"
                                      CreateResources="LyricsCanvas_CreateResources"
                                      Draw="LyricsCanvas_Draw"
                                      SizeChanged="LyricsCanvas_SizeChanged"
                                      PointerPressed="LyricsCanvas_PointerPressed"
                                      PointerReleased="LyricsCanvas_PointerReleased"
                                      PointerWheelChanged="LyricsCanvas_PointerWheelChanged"
                                      ContextRequested="LyricsCanvas_ContextRequested"/>

                <!-- 手动滚动时显示：回到当前播放位置 -->
                <Button x:Name="BackToCurrentButton"
                        Click="BackToCurrentButton_Click"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,28"
                        Padding="16,9"
                        CornerRadius="20"
                        Background="#26FFFFFF"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        Visibility="Collapsed"
                        Opacity="0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74A;" FontSize="13" Foreground="White"/>
                        <TextBlock Text="回到当前" FontSize="13" Foreground="White"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- 全屏 / 关闭按钮 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="12,8,0,0" Spacing="4">
            <Button x:Name="FullscreenButton"
                    Click="FullscreenButton_Click"
                    Padding="8"
                    Background="Transparent" BorderThickness="0"
                    CornerRadius="18" Width="36" Height="36"
                    Opacity="0.35">
                <FontIcon x:Name="FullscreenIcon" Glyph="&#xE740;" FontSize="13" Foreground="#BBFFFFFF"/>
            </Button>
            <Button x:Name="CloseButton"
                    Click="CloseButton_Click"
                    Padding="8"
                    Background="Transparent" BorderThickness="0"
                    CornerRadius="18" Width="36" Height="36"
                    Opacity="0.35">
                <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="#BBFFFFFF"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
