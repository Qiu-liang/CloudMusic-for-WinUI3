<Window
    x:Class="music.LyricsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Title="歌词">

    <Grid x:Name="RootGrid"
          Background="#0C0C0E"
          PointerPressed="RootGrid_PointerPressed"
          SizeChanged="RootGrid_SizeChanged">
        <win2d:CanvasControl x:Name="BackgroundCanvas"
                              Draw="BackgroundCanvas_Draw"
                              IsHitTestVisible="False"
                              Opacity="0.9"/>

        <Grid IsHitTestVisible="False">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#08000000" Offset="0"/>
                    <GradientStop Color="#14000000" Offset="0.55"/>
                    <GradientStop Color="#38000000" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="45*"/>
                <ColumnDefinition x:Name="RightColumn" Width="55*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" x:Name="LeftPanel">
                <StackPanel x:Name="LeftContentPanel"
                            Width="440"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="26">
                    <Border x:Name="CoverBorder"
                            Width="440"
                            Height="440"
                            CornerRadius="6"
                            HorizontalAlignment="Stretch"
                            Background="#10FFFFFF">
                        <Image x:Name="AlbumCoverImage" Stretch="UniformToFill"/>
                    </Border>

                    <StackPanel x:Name="SongInfoPanel"
                                HorizontalAlignment="Stretch"
                                Spacing="8">
                        <TextBlock x:Name="SongTitleText"
                                   FontSize="16"
                                   FontWeight="Normal"
                                   Foreground="#F2FFFFFF"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ArtistAlbumText"
                                   FontSize="13"
                                   Foreground="#99FFFFFF"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel x:Name="ControlsPanel"
                                Width="336"
                                HorizontalAlignment="Center"
                                Spacing="10"
                                Margin="0,2,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CurrentTimeText"
                                       Grid.Column="0"
                                       Text="0:00"
                                       FontSize="11"
                                       Foreground="#99FFFFFF"
                                       FontFamily="Consolas"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <Slider x:Name="ProgressSlider"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="100"
                                    Height="20"
                                    MinHeight="20"
                                    Padding="0"
                                    BorderThickness="0"
                                    Foreground="#F2FFFFFF"
                                    Background="#40FFFFFF"
                                    VerticalAlignment="Center"
                                    ValueChanged="ProgressSlider_ValueChanged"
                                    IsThumbToolTipEnabled="False"/>
                            <TextBlock x:Name="TotalTimeText"
                                       Grid.Column="2"
                                       Text="-0:00"
                                       FontSize="11"
                                       Foreground="#99FFFFFF"
                                       FontFamily="Consolas"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"/>
                        </Grid>

                        <Grid Height="42">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Spacing="4">
                                <Button x:Name="VolumeButton"
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="4"
                                        ToolTipService.ToolTip="音量">
                                    <FontIcon x:Name="VolumeIcon"
                                              Glyph="&#xE767;"
                                              FontSize="14"
                                              Foreground="#CCFFFFFF"/>
                                    <Button.Flyout>
                                        <Flyout>
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="12"
                                                        MinWidth="210">
                                                <FontIcon Glyph="&#xE767;"
                                                          FontSize="14"
                                                          VerticalAlignment="Center"/>
                                                <Slider x:Name="VolumeSlider"
                                                        Width="170"
                                                        Minimum="0"
                                                        Maximum="100"
                                                        Value="80"
                                                        VerticalAlignment="Center"
                                                        ValueChanged="VolumeSlider_ValueChanged"
                                                        IsThumbToolTipEnabled="False"/>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <Button x:Name="MoreButton"
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="4"
                                        ToolTipService.ToolTip="更多播放选项">
                                    <FontIcon Glyph="&#xE712;"
                                              FontSize="14"
                                              Foreground="#CCFFFFFF"/>
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="随机播放"
                                                            Click="ShuffleButton_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon x:Name="ShuffleIcon"
                                                              Glyph="&#xE8B1;"
                                                              FontSize="14"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="循环播放"
                                                            Click="RepeatButton_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon x:Name="RepeatIcon"
                                                              Glyph="&#xE8EE;"
                                                              FontSize="14"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8">
                                <Button x:Name="PrevButton"
                                        Click="PrevButton_Click"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Width="34"
                                        Height="36"
                                        CornerRadius="4"
                                        ToolTipService.ToolTip="上一首">
                                    <FontIcon Glyph="&#xE892;"
                                              FontSize="19"
                                              Foreground="#F2FFFFFF"/>
                                </Button>
                                <Button x:Name="PlayPauseButton"
                                        Click="PlayPauseButton_Click"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Width="36"
                                        Height="36"
                                        CornerRadius="4"
                                        ToolTipService.ToolTip="播放 / 暂停">
                                    <FontIcon x:Name="PlayPauseIcon"
                                              Glyph="&#xE768;"
                                              FontSize="22"
                                              Foreground="White"/>
                                </Button>
                                <Button x:Name="NextButton"
                                        Click="NextButton_Click"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Width="34"
                                        Height="36"
                                        CornerRadius="4"
                                        ToolTipService.ToolTip="下一首">
                                    <FontIcon Glyph="&#xE893;"
                                              FontSize="19"
                                              Foreground="#F2FFFFFF"/>
                                </Button>
                            </StackPanel>

                            <Button x:Name="LyricsButton"
                                    Grid.Column="2"
                                    Click="LyricsButton_Click"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="#14FFFFFF"
                                    BorderThickness="0"
                                    Padding="0"
                                    Width="32"
                                    Height="32"
                                    CornerRadius="4"
                                    ToolTipService.ToolTip="返回播放界面">
                                <FontIcon Glyph="&#xE8A7;"
                                          FontSize="15"
                                          Foreground="#F2FFFFFF"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1" x:Name="LyricsPanel">
                <win2d:CanvasControl x:Name="LyricsCanvas"
                                      CreateResources="LyricsCanvas_CreateResources"
                                      Draw="LyricsCanvas_Draw"
                                      SizeChanged="LyricsCanvas_SizeChanged"
                                      PointerPressed="LyricsCanvas_PointerPressed"
                                      PointerReleased="LyricsCanvas_PointerReleased"
                                      PointerWheelChanged="LyricsCanvas_PointerWheelChanged"
                                      ContextRequested="LyricsCanvas_ContextRequested"/>

                <Button x:Name="BackToCurrentButton"
                        Click="BackToCurrentButton_Click"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,36"
                        Padding="16,9"
                        CornerRadius="20"
                        Background="#26FFFFFF"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        Visibility="Collapsed"
                        Opacity="0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74A;" FontSize="13" Foreground="White"/>
                        <TextBlock Text="回到当前" FontSize="13" Foreground="White"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <StackPanel x:Name="WindowActionsPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,6,12,0"
                    Spacing="2">
            <Button x:Name="FullscreenButton"
                    Click="FullscreenButton_Click"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="4"
                    Width="30"
                    Height="30"
                    Opacity="0.55"
                    ToolTipService.ToolTip="全屏 / 还原">
                <FontIcon x:Name="FullscreenIcon"
                          Glyph="&#xE740;"
                          FontSize="12"
                          Foreground="#E6FFFFFF"/>
            </Button>
            <Button x:Name="CloseButton"
                    Click="CloseButton_Click"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="4"
                    Width="30"
                    Height="30"
                    Opacity="0.55"
                    ToolTipService.ToolTip="关闭">
                <FontIcon Glyph="&#xE711;"
                          FontSize="12"
                          Foreground="#E6FFFFFF"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
