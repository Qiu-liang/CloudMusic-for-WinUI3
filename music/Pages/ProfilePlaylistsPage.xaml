<Page
    x:Class="music.Pages.ProfilePlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:music.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 加载中 -->
        <Grid x:Name="LoadingPanel">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <ProgressRing IsActive="True" Width="32" Height="32"/>
                <TextBlock Text="加载中..."
                           Style="{StaticResource BodyTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- 内容区域 -->
        <ScrollViewer x:Name="ContentPanel" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Margin="24,0,24,24">

                <!-- 我创建的歌单 -->
                <StackPanel x:Name="CreatedSection" Visibility="Collapsed">
                    <TextBlock Text="我创建的歌单"
                               FontSize="18" FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <GridView x:Name="CreatedGridView"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="GridView_ItemClick">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:PlaylistItem">
                                <Border Width="160"
                                        CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        Padding="0,0,0,12"
                                        Margin="0,0,8,8">
                                    <StackPanel Spacing="8">
                                        <Border Height="160" CornerRadius="8,8,0,0"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}">
                                            <Grid>
                                                <FontIcon Glyph="&#xE8D6;" FontSize="40"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <Image Source="{x:Bind PicUrl}"
                                                       Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Padding="8,0,8,0" Spacing="2">
                                            <TextBlock Text="{x:Bind Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       MaxLines="2"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       MaxLines="1"
                                                       Text="{x:Bind PlayCountFormatted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <!-- 我收藏的歌单 -->
                <StackPanel x:Name="CollectedSection" Visibility="Collapsed">
                    <TextBlock Text="我收藏的歌单"
                               FontSize="18" FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <GridView x:Name="CollectedGridView"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="GridView_ItemClick">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:PlaylistItem">
                                <Border Width="160"
                                        CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        Padding="0,0,0,12"
                                        Margin="0,0,8,8">
                                    <StackPanel Spacing="8">
                                        <Border Height="160" CornerRadius="8,8,0,0"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}">
                                            <Grid>
                                                <FontIcon Glyph="&#xE8D6;" FontSize="40"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <Image Source="{x:Bind PicUrl}"
                                                       Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Padding="8,0,8,0" Spacing="2">
                                            <TextBlock Text="{x:Bind Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       MaxLines="2"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       MaxLines="1"
                                                       Text="{x:Bind PlayCountFormatted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <!-- 空状态 -->
                <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                            Margin="0,60,0,0">
                    <FontIcon Glyph="&#xE8F2;" FontSize="48"
                              HorizontalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="暂无歌单"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
