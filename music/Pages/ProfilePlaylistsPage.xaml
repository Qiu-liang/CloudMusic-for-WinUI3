<Page
    x:Class="music.Pages.ProfilePlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:items="using:music.Core.ViewModels.Items"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="LoadingPanel" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <ProgressRing IsActive="True" Width="32" Height="32"/>
                <TextBlock Text="加载中..."
                           Style="{StaticResource BodyTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="ContentPanel" Visibility="{x:Bind ViewModel.IsContent, Mode=OneWay}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Margin="24,0,24,24">

                <StackPanel x:Name="CreatedSection" Visibility="{x:Bind ViewModel.HasCreated, Mode=OneWay}">
                    <TextBlock Text="我创建的歌单"
                               FontSize="18" FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <GridView x:Name="CreatedGridView"
                              ItemsSource="{x:Bind ViewModel.CreatedPlaylists, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="GridView_ItemClick">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="items:PlaylistItem">
                                <Border Width="160"
                                        CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        Padding="0,0,0,12"
                                        Margin="0,0,8,8">
                                    <StackPanel Spacing="8">
                                        <Border Height="160" CornerRadius="8,8,0,0"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}">
                                            <Grid>
                                                <FontIcon Glyph="&#xE8D6;" FontSize="40"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <Image Source="{x:Bind PicUrl}"
                                                       Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Padding="8,0,8,0" Spacing="2">
                                            <TextBlock Text="{x:Bind Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       MaxLines="2"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       MaxLines="1"
                                                       Text="{x:Bind PlayCountFormatted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <StackPanel x:Name="CollectedSection" Visibility="{x:Bind ViewModel.HasCollected, Mode=OneWay}">
                    <TextBlock Text="我收藏的歌单"
                               FontSize="18" FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <GridView x:Name="CollectedGridView"
                              ItemsSource="{x:Bind ViewModel.CollectedPlaylists, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="GridView_ItemClick">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="items:PlaylistItem">
                                <Border Width="160"
                                        CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        Padding="0,0,0,12"
                                        Margin="0,0,8,8">
                                    <StackPanel Spacing="8">
                                        <Border Height="160" CornerRadius="8,8,0,0"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}">
                                            <Grid>
                                                <FontIcon Glyph="&#xE8D6;" FontSize="40"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <Image Source="{x:Bind PicUrl}"
                                                       Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Padding="8,0,8,0" Spacing="2">
                                            <TextBlock Text="{x:Bind Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       MaxLines="2"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       MaxLines="1"
                                                       Text="{x:Bind PlayCountFormatted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel x:Name="EmptyState" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
            <FontIcon Glyph="&#xE8F2;" FontSize="48"
                      HorizontalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="暂无歌单"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <Grid x:Name="ErrorPanel" Visibility="{x:Bind ViewModel.IsError, Mode=OneWay}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE783;" FontSize="48"
                          HorizontalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
