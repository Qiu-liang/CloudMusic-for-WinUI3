<Page
    x:Class="music.Pages.ProfileFollowListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:items="using:music.Core.ViewModels.Items"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled">

    <Grid>
        <Grid x:Name="LoadingPanel" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <ProgressRing IsActive="True" Width="32" Height="32"/>
                <TextBlock Text="加载中..." HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="EmptyState" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE77B;" FontSize="48" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="EmptyText" Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="ErrorPanel" Visibility="{x:Bind ViewModel.IsError, Mode=OneWay}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE783;" FontSize="48" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <ListView x:Name="UserListView"
                  ItemsSource="{x:Bind ViewModel.Users, Mode=OneWay}"
                  Visibility="{x:Bind ViewModel.IsContent, Mode=OneWay}"
                  SelectionMode="None" Margin="24,0,24,24">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="items:FollowUserItem">
                    <Grid Height="72" Padding="8,6" Tag="{x:Bind UserId}" Tapped="User_Tapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                                Background="{ThemeResource ControlFillColorDefaultBrush}">
                            <Image Source="{x:Bind AvatarUrl}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" Spacing="2">
                            <TextBlock Text="{x:Bind Nickname}" FontSize="15" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Signature}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Footer>
                <Grid Height="80"/>
            </ListView.Footer>
        </ListView>
    </Grid>
</Page>
