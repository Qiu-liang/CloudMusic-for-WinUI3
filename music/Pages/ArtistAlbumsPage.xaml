<Page
    x:Class="music.Pages.ArtistAlbumsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:music.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 加载中 -->
        <Grid x:Name="LoadingPanel">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <ProgressRing IsActive="True" Width="32" Height="32"/>
                <TextBlock Text="加载中..."
                           Style="{StaticResource BodyTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- 专辑列表 -->
        <GridView Grid.Row="0"
                  x:Name="AlbumsGridView"
                  Visibility="Collapsed"
                  Margin="24,0,24,24"
                  Padding="0,0,0,16"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="AlbumsGridView_ItemClick">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:AlbumItem">
                    <Border Width="180"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            Padding="0,0,0,12"
                            Margin="0,0,8,8">
                        <StackPanel Spacing="8">
                            <Border Height="180" CornerRadius="8,8,0,0"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                                <Grid>
                                    <FontIcon Glyph="&#xE8D6;" FontSize="48"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Visibility="{x:Bind PicVisibility}"/>
                                    <Image Source="{x:Bind PicUrl}"
                                           Stretch="UniformToFill"
                                           Visibility="{x:Bind PicVisibility}"/>
                                </Grid>
                            </Border>
                            <StackPanel Padding="8,0,8,0" Spacing="2">
                                <TextBlock Text="{x:Bind Name}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind SizeText}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           MaxLines="1"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
            <GridView.Footer>
                <Grid Height="80"/>
            </GridView.Footer>
        </GridView>
    </Grid>
</Page>
