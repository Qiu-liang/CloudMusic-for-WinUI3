<Page
    x:Class="music.Pages.ArtistInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:music.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <!-- 加载中 -->
        <Grid x:Name="LoadingPanel">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <ProgressRing IsActive="True" Width="32" Height="32"/>
                <TextBlock Text="加载中..." 
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- 歌手详情 -->
        <ScrollViewer x:Name="ContentPanel" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Margin="24,16,24,16">

                <!-- 歌手头像和名字 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="120" Height="120"
                            CornerRadius="60"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            Margin="0,0,16,0">
                        <Grid>
                            <FontIcon Glyph="&#xE77B;" FontSize="40"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Image x:Name="ArtistImage"
                                   Stretch="UniformToFill"
                                   Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                        <TextBlock x:Name="ArtistNameText"
                                   FontSize="24"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="AliasText"
                                   FontSize="14"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <!-- 简介 -->
                <StackPanel x:Name="DescriptionSection" Visibility="Collapsed" Spacing="8">
                    <TextBlock Text="简介" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DescriptionText"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
