<Page
    x:Class="music.Pages.ArtistInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid x:Name="LoadingPanel" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <ProgressRing IsActive="True" Width="32" Height="32"/>
                <TextBlock Text="加载中..."
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="ErrorPanel" Visibility="{x:Bind ViewModel.IsError, Mode=OneWay}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE783;" FontSize="48"
                          HorizontalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="ContentPanel" Visibility="{x:Bind ViewModel.IsContent, Mode=OneWay}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Margin="24,16,24,16">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="120" Height="120"
                            CornerRadius="60"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            Margin="0,0,16,0">
                        <Grid>
                            <FontIcon Glyph="&#xE77B;" FontSize="40"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Image x:Name="ArtistImage"
                                   Stretch="UniformToFill"
                                   Visibility="{x:Bind ViewModel.HasImage, Mode=OneWay}"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                        <TextBlock x:Name="ArtistNameText"
                                   Text="{x:Bind ViewModel.ArtistName, Mode=OneWay}"
                                   FontSize="24"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="AliasText"
                                   Text="{x:Bind ViewModel.AliasText, Mode=OneWay}"
                                   FontSize="14"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind ViewModel.ShowAlias, Mode=OneWay}"/>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="DescriptionSection" Visibility="{x:Bind ViewModel.ShowDescription, Mode=OneWay}" Spacing="8">
                    <TextBlock Text="简介" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DescriptionText"
                               Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
