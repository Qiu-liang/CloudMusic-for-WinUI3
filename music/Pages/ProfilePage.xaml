<Page
    x:Class="music.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="24,16,24,8">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE77B;" FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                <TextBlock Text="个人中心"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="UserInfoSection" Grid.Row="1" Margin="24,0,24,16" Visibility="{x:Bind ViewModel.IsContent, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="160" Height="160"
                    CornerRadius="80"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    Margin="0,0,20,0">
                <Grid>
                    <FontIcon Glyph="&#xE77B;" FontSize="48"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Image x:Name="AvatarImage"
                           Stretch="UniformToFill"
                           Visibility="{x:Bind ViewModel.HasAvatar, Mode=OneWay}"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="NicknameText"
                               Text="{x:Bind ViewModel.Nickname, Mode=OneWay}"
                               FontSize="28"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis"/>
                    <Border x:Name="VipBadge"
                            Visibility="{x:Bind ViewModel.IsVip, Mode=OneWay}"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="4"
                            Padding="8,3"
                            VerticalAlignment="Center">
                        <TextBlock Text="VIP"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="StatsText"
                           Text="{x:Bind ViewModel.StatsText, Mode=OneWay}"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind ViewModel.ShowStats, Mode=OneWay}"/>

                <TextBlock x:Name="SignatureText"
                           Text="{x:Bind ViewModel.Signature, Mode=OneWay}"
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           MaxLines="4"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{x:Bind ViewModel.ShowSignature, Mode=OneWay}"/>

                <Button x:Name="ForceLogoutButton"
                        Command="{x:Bind ViewModel.ForceLogoutCommand, Mode=OneWay}"
                        Content="退出登录"
                        Visibility="{x:Bind ViewModel.ShowForceLogout, Mode=OneWay}"
                        HorizontalAlignment="Left"
                        Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" x:Name="LoadingPanel" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <ProgressRing IsActive="True" Width="32" Height="32"/>
                <TextBlock Text="加载中..."
                           Style="{StaticResource BodyTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <NavigationView Grid.Row="2"
                        x:Name="ProfileNavView"
                        PaneDisplayMode="Top"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="ProfileNavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="歌单" Tag="playlists" IsSelected="True"/>
                <NavigationViewItem Content="最近" Tag="recent"/>
                <NavigationViewItem Content="关注" Tag="follows"/>
                <NavigationViewItem Content="粉丝" Tag="followeds"/>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Margin="0,12,0,0"/>
        </NavigationView>
    </Grid>
</Page>
