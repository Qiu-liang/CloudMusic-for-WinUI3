<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="music.Controls.MarqueeText"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch">

    <Grid x:Name="ClipHost"
          Background="Transparent"
          HorizontalAlignment="Stretch"
          SizeChanged="ClipHost_SizeChanged"
          PointerEntered="ClipHost_PointerEntered"
          PointerExited="ClipHost_PointerExited">
        <Canvas x:Name="TextCanvas" VerticalAlignment="Center">
            <StackPanel x:Name="ScrollTrack"
                        Orientation="Horizontal"
                        Spacing="36">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="TrackTransform" X="0" Y="0"/>
                </StackPanel.RenderTransform>
                <TextBlock x:Name="PrimaryText"
                           TextWrapping="NoWrap"
                           MaxLines="1"/>
                <TextBlock x:Name="SecondaryText"
                           TextWrapping="NoWrap"
                           MaxLines="1"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Canvas>
    </Grid>
</UserControl>
